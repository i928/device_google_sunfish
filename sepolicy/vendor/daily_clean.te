# =====================================================================
# SELinux Policy Definition for F2FS Automated Compression Utility
# Target Path: device/google/sunfish/sepolicy/vendor/daily_clean.te
# =====================================================================

# Define the service running domain and binary execution type
type daily_clean, domain;
type daily_clean_exec, exec_type, vendor_file_type, file_type;

# Transition this daemon safely into the standard init loop domain mapping
init_daemon_domain(daily_clean)

# OPTIONAL DEBUG FLAG: Uncomment the line below during active testing to track missing permissions.
# It makes this specific domain lenient, reporting audit warnings instead of forcing absolute denials.
# permissive daily_clean;

# ---------------------------------------------------------------------
# Base Shell Execution Privileges
# ---------------------------------------------------------------------
# Allow the domain to execute basic hardware shell commands and standard vendor toolboxes
allow daily_clean vendor_shell_exec:file rx_file_perms;
allow daily_clean vendor_toolbox_exec:file rx_file_perms;

# ---------------------------------------------------------------------
# Target Path Storage and Metadata File Permissions
# ---------------------------------------------------------------------
# Grant authority to look up partition geometry layouts via system mount topologies
allow daily_clean proc_mounts:file r_file_perms;

# Grant read, write, and runtime folder creation privileges inside the physical unencrypted storage layer
allow daily_clean media_rw_data_file:dir create_dir_perms;
allow daily_clean media_rw_data_file:file create_file_perms;

# ---------------------------------------------------------------------
# F2FS Kernel Node and Binary Framework Configuration
# ---------------------------------------------------------------------
# Allow access to read system layout structures and features inside the F2FS subsystem folder mapping
allow daily_clean sysfs_fs_f2fs:dir r_dir_perms;
allow daily_clean sysfs_fs_f2fs:file rw_file_perms;

# Grant explicit binary execution rights for /product/bin/f2fs_io (typically labeled under core system maps)
allow daily_clean system_file:file rx_file_perms;

# ---------------------------------------------------------------------
# Inter-Process Communication (IPC) Services Mapping for Cache Eviction
# ---------------------------------------------------------------------
# Allow the process to communicate via Binder with core OS layers to successfully handle 'cmd package trim-caches'
allow daily_clean system_server:binder call;
allow daily_clean servicemanager:binder call;
allow daily_clean package_service:service_manager find;
