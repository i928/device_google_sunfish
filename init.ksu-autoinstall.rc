# Seed ksud, and run the KSU autoinstall script once boot completes.
# How to set up the modules it installs: device/google/sunfish/KSU.md.
#
# Seeding ksud: on a wiped device /data/adb/ksud does not exist until the
# manager app is opened, and without it KernelSU is completely inert:
#   init: Command 'exec u:r:ksu:s0 root -- /data/adb/ksud post-fs-data'
#         failed: Cannot find '/data/adb/ksud'
# ...and the same for `services` and `boot-completed`. `copy` is a built-in init
# command, so this needs no exec and no new sepolicy. It is the official ksud
# shipped in this ROM (/system_ext/etc/ksu, see device.mk), so it matches this
# kernel whichever manager is installed. Rewritten every boot, which also
# repairs a deleted or truncated ksud.
#
# KSU's own post-fs-data exec (init.rc) runs before this action, so on the very
# first boot after a wipe that stage is still skipped -- harmless, as there are
# no modules to mount yet. `services` and `boot-completed` come later and do
# find it.
on post-fs-data
    mkdir /data/adb 0700 root root
    copy /system_ext/etc/ksu/ksud /data/adb/ksud
    chmod 0755 /data/adb/ksud
    chown root root /data/adb/ksud
    # `ksud install` is what the manager runs on first launch: it unpacks
    # busybox into /data/adb/ksu/bin. ksud runs every service.d script as
    # `/data/adb/ksu/bin/busybox sh <script>`, so on a wiped device -- until
    # the manager is opened -- no script runs at all. Run from the ROM copy,
    # not /data/adb/ksud: install deletes /data/adb/ksud and copies its own
    # executable back over it, which fails when that is the file it runs from.
    # --libadbroot (ksud 3.4+) matches what the 3.4 manager passes.
    exec u:r:ksu:s0 root -- /system_ext/etc/ksu/ksud install --libadbroot /system_ext/etc/ksu/libadbroot.so
    # First boot after a wipe: stage the module snapshot (in place of zip
    # installs); ksu-autoinstall.sh then does the one activation reboot.
    exec u:r:ksu:s0 root -- /system/bin/sh /system_ext/bin/ksu-snapshot.sh
    mkdir /data/adb/service.d 0755 root root
    mkdir /data/adb/.ksu-autoinstall 0700 root root
    exec u:r:ksu:s0 root root -- /system/bin/sh -c "D=/data/adb/service.d/ksu-autoinstall.sh S=/data/adb/.ksu-autoinstall/seeded-ksu-autoinstall.sh; if [ ! -f $$D ] || [ ! -f $$S ] || cmp -s $$D $$S; then cp /system_ext/bin/ksu-autoinstall.sh $$D && chmod 0755 $$D && cp $$D $$S; fi"

# The autoinstall script is installed into /data/adb/service.d above and run by
# ksud's own `services` stage, which (in ksud 3.3.0) starts service.d scripts
# without waiting, in their own process group and moved out of init's cgroup,
# so they are neither killed nor holding up boot. service.d rather than
# post-fs-data.d: ksud's post-fs-data exec runs before this action, so on the
# first boot after a wipe -- the boot this exists for -- /data/adb/ksud does not
# exist yet and that stage is skipped; `services` comes later and finds both.
# Replaced by the ROM's copy when missing or unedited: seeded-ksu-autoinstall.sh
# remembers what was last seeded, so a ROM update brings its new script, while
# a copy edited on the device for testing survives reboots and updates (delete
# it to go back to the ROM's). Phones seeded before this check have no record,
# so their copy is replaced once. `$$` is init's escape for a literal `$`.
# `copy` always overwrites, hence `exec sh -c`, in the
# u:r:ksu:s0 context KernelSU's own init.rc exec uses (init cannot exec a shell in
# its own domain). The copy in post-fs-data.d from earlier builds is removed so
# the script does not run twice.
